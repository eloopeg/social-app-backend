{
  "info": {
    "name": "Eloop Social API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ahmed Bahnasy\",\n  \"username\": \"Bahnasy202222\",\n  \"email\": \"bahnasyd20222@gmail.com\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"gender\": \"male\",\n  \"password\": \"Aa@123456\",\n  \"rePassword\": \"Aa@123456\"\n}"
        },
        "url": "{{baseUrl}}/users/signup"
      }
    },
    {
      "name": "Signin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"ada\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/users/signin"
      }
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/profile-data"
      }
    },
    {
      "name": "Users",
      "request": { "method": "GET", "url": "{{baseUrl}}/users" }
    },
    {
      "name": "Suggestions",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/suggestions?page=1&limit=10"
      }
    },
    {
      "name": "Create Post",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Hello from Eloop\",\n  \"image\": \"\"\n}"
        },
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "List Posts",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/posts?page=1&limit=10"
      }
    },
    {
      "name": "Like Post",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/posts/{{postId}}/like"
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Great post!\"\n}"
        },
        "url": "{{baseUrl}}/posts/{{postId}}/comments"
      }
    },
    {
      "name": "Get Comments",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/posts/{{postId}}/comments?page=1&limit=10"
      }
    },
    {
      "name": "Delete Comment",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/comments/{{commentId}}"
      }
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/notifications?page=1&limit=10"
      }
    }
  ]
}
