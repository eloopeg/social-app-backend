{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/docs.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/docs", "dest": "/api/docs.js" },
    { "src": "/api/docs", "dest": "/api/docs.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
